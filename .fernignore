# Files Fern must NOT overwrite when it regenerates this SDK (via PR from the
# hedra-labs/fern-config repo). See https://buildwithfern.com/learn/sdks/capabilities/customize-files

# PyPI distribution name (hedra-python) + project metadata; import name is `hedra`
pyproject.toml
# ...and the lockfile resolved against it (Fern's lock targets its own pyproject)
poetry.lock

# Local-dev ignores are hand-maintained
.gitignore

# README install/badge + usage use the hedra-python distribution name
README.md

# version.py looks up the hedra-python distribution
src/hedra/version.py
# Hand-written client wrapper: reads HEDRA_API_KEY at construction time.
# BaseHedra/AsyncBaseHedra (base_client.py) regenerate normally.
src/hedra/client.py

# Fix for retry-after-ms parsing (upstream Fern emits a str-vs-int comparison,
# swallowed by a bare `except`, so upstream silently ignores the header).
# Still unfixed upstream as of fern-python-sdk 5.26.0 — verified by diffing this
# file against /assets/core_utilities/http_client.py in the 5.26.0 generator image.
# Guarded by tests/custom/test_client.py::test_parse_retry_after_ms_header.
#
# BECAUSE THIS FILE IS FROZEN, IT MUST BE HAND-PORTED ON EVERY GENERATOR BUMP.
# It is currently hand-ported to 5.26.0 and is byte-identical to that generator's
# output except for the one deviation marked "LOCAL DEVIATION" in the file.
# To re-port after a bump:
#   cid=$(docker create fernapi/fern-python-sdk:<version>)
#   docker cp "$cid:/assets/core_utilities/http_client.py" /tmp/upstream.py
#   docker rm -f "$cid"
#   diff -u /tmp/upstream.py src/hedra/core/http_client.py
# Drop this entry once upstream fixes retry-after-ms; then the file regenerates
# normally and the freeze/drift cycle ends.
src/hedra/core/http_client.py


# Hand-maintained docs / history
CHANGELOG.md
MIGRATION.md
LICENSE

# CI is hand-maintained (Fern doesn't manage workflows here)
.github/

# Hand-written tests
tests/custom/
.fern/replay.lock
.fern/replay.yml
.gitattributes
